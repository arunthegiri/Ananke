ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here

# ── Copilot LLM ──────────────────────────────────────────────────────────────
# Bring any provider: pick openai_compatible or anthropic, then fill in that
# provider's block below. Without a configured provider the /api/copilot/*
# endpoints return 503 and the Copilot tab shows a configuration notice.
LLM_PROVIDER=openai_compatible

# openai_compatible covers OpenAI, Kimi/Moonshot, Groq, Together, DeepSeek,
# OpenRouter, and any local model server with an OpenAI-compatible
# /chat/completions endpoint. Leave LLM_API_KEY blank for a local server that
# doesn't check it.
#
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o
#   Kimi:      LLM_BASE_URL=https://api.moonshot.ai/v1       LLM_MODEL=kimi-k2-0905-preview
#   Ollama:    LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1:70b
#   LM Studio: LLM_BASE_URL=http://localhost:1234/v1         LLM_MODEL=<model loaded in LM Studio>
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL=kimi-k2-0905-preview

# anthropic — used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
